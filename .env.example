# ---- Discord ----
BOT_TOKEN=
CLIENT_ID=
GUILD_ID=            # test server (guild) ID
PROD_GUILD_ID=       # Toeshank's server (guild) ID

# ---- Google Sheets ----
# TDL spreadsheet: https://docs.google.com/spreadsheets/d/1gz1sIYGUf-vxMCmsl7b7icFfI9HlAYSbs1rOFRCz1Ww
TDL_SPREADSHEET_ID=1gz1sIYGUf-vxMCmsl7b7icFfI9HlAYSbs1rOFRCz1Ww
# Reuse DFC's service account (grant it Editor on the sheet above)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ---- Mode ----
# true  -> writes to the "Registration Test" tab (QA)
# false -> writes to the "Registration" tab (production)
TEST_MODE=true

# ---- Roles ----
# Discord role name required to use /signup
DUELER_ROLE_NAME=Dueler
# Optional: role name allowed to register OTHER members via /register.
# Members with the Manage Server permission can always do this too.
# If unset, only Manage-Server members can register others; anyone can still
# self-register.
TDL_ADMIN_ROLE_NAME=

# ---- Channels ----
# Optional: dedicated channel ID for public signup confirmations.
# If unset, confirmations post in the channel where /signup was run.
SIGNUP_CHANNEL_ID=

# ---- Redis (optional read caching) ----
# Caches the roster map (10-min TTL) and current-week signups (2-h TTL) so
# /signup and /recentsignups can skip Sheets reads.
# Unset = no cache; the bot falls back to live Sheets reads (works, just slower).
#
# The client resolves the URL from the first of these that is set (priority order):
#   REDIS_URL       - Heroku Data for Redis (Heroku's first-party add-on)
#   REDISCLOUD_URL  - Redis Cloud add-on (Redis Ltd)
#   REDIS_TLS_URL   - explicit TLS endpoint some plans also expose
# On Heroku the relevant var is set automatically when the add-on is provisioned;
# you normally do NOT set these by hand there. Locally, set one to point at your
# own Redis. A `rediss://` (TLS) URL is auto-configured for Heroku's self-signed
# certificate — no extra flags needed.
REDIS_URL=
REDISCLOUD_URL=
